{
  "name": "raceloom",
  "version": "0.1.0",
  "description": "Find race conditions in async JavaScript. Explores every ordering of your awaits, shrinks the failure, and prints the exact interleaving.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "types": "./src/index.d.ts",
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "examples": "node --test examples/*.test.js",
    "typecheck": "tsc -p ."
  },
  "keywords": [
    "race-condition",
    "concurrency",
    "testing",
    "async",
    "deterministic-simulation",
    "model-checking",
    "loom",
    "fuzzing",
    "promises",
    "interleaving"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anime5hka/raceloom.git"
  }
}
